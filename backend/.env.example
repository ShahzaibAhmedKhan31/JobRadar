# ---------------------------------------------------------------------------
# JobRadar backend configuration (copy to backend/.env and adjust if needed)
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the API, Alembic and the tests.
# Matches the credentials in the repository-root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5432/jobradar

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ENVIRONMENT=development
LOG_LEVEL=INFO

# Wait for PostgreSQL on startup instead of crashing when it is still booting.
DB_WAIT_ON_STARTUP=true

# Maximum number of rows stored per source refresh (protects manual refresh).
MAX_REFRESH_JOBS_PER_SOURCE=500

# Optional allow-list of provider keys, comma separated.
# Leave empty to expose every registered provider.
# ENABLED_SOURCES=fixtures,manual_import

# Background scheduler. The toggle inside Search Settings controls whether
# automatic refresh actually runs; these values are the defaults/seed.
SCHEDULER_ENABLED=true
SCHEDULED_REFRESH_ENABLED=false
SCHEDULED_REFRESH_INTERVAL_MINUTES=60
