# ---------------------------------------------------------------------------
# JobRadar backend configuration (copy to backend/.env and adjust if needed)
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the API, Alembic and the tests.
# Matches the credentials in the repository-root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5432/jobradar

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ENVIRONMENT=development
LOG_LEVEL=INFO

# Wait for PostgreSQL on startup instead of crashing when it is still booting.
DB_WAIT_ON_STARTUP=true

# Refuse to start when the database schema is older than the code (the usual
# cause of "column ... does not exist" 500s). Run `alembic upgrade head` first.
SCHEMA_CHECK_ON_STARTUP=true
# Set to true to let the API apply pending migrations itself on startup.
SCHEMA_AUTO_UPGRADE=false

# Maximum number of rows stored per source refresh (protects manual refresh).
MAX_REFRESH_JOBS_PER_SOURCE=500

# Optional allow-list of provider keys, comma separated.
# Leave empty to expose every registered provider.
# ENABLED_SOURCES=fixtures,manual_import

# Background scheduler. The toggle inside Search Settings controls whether
# automatic refresh actually runs; these values are the defaults/seed.
SCHEDULER_ENABLED=true
SCHEDULED_REFRESH_ENABLED=false
SCHEDULED_REFRESH_INTERVAL_MINUTES=60

# ------------------------------- Scraping -----------------------------------
# Optional LinkedIn / Indeed retrieval through python-jobspy.
# Install the extra first: pip install -r requirements-scraping.txt
# Scraping may breach the board's terms of service and can be throttled or
# blocked; keep refreshes manual and infrequent.
JOBSPY_ENABLED=true
# Which boards to scrape (comma separated). Opt in to more with e.g.
# JOBSPY_SITES=linkedin,indeed
JOBSPY_SITES=linkedin
# Listings requested per search term, and how many saved titles/keywords are
# turned into search terms (each term is one HTTP request).
JOBSPY_RESULTS_WANTED=25
JOBSPY_MAX_SEARCH_TERMS=3
# Delay between scrape requests, in seconds (politeness / rate limiting).
JOBSPY_REQUEST_DELAY_SECONDS=2
# Optional rotating proxies, comma separated.
# JOBSPY_PROXIES=http://user:pass@host:port
# Country hint for the Indeed scraper only.
JOBSPY_COUNTRY=pakistan
# Fetch full descriptions: one extra request per listing, much higher throttle risk.
JOBSPY_FETCH_DESCRIPTION=false
JOBSPY_VERBOSE=0
